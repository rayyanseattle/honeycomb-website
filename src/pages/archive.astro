---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Lightbox from '../components/Lightbox.astro';
import { getImage } from 'astro:assets';
import { archiveCategories } from '../data/site';
import { photo, byPrefix } from '../lib/photos';

const groups = archiveCategories.map((c) => ({ ...c, items: byPrefix(c.prefix) }));
const all = groups.flatMap((g) => g.items.map((it) => ({ ...it, cat: g.key })));
const fulls = new Map(await Promise.all(all.map(async (it) => [it.slug, (await getImage({ src: photo(it.slug), width: 1800, format: 'webp' })).src] as const)));
const count = all.length;
---
<Base title="Textile Archive" description="A private collection of antique Indian textiles: kantha, patola, appliqué, Kashmir shawls, bandhani, mochi embroidery, kalamkari and brocade." navTheme="dark">
  <section class="ahero section--forest" data-hero>
    <div class="wrap ahero__inner">
      <p class="eyebrow eyebrow--dark" data-reveal="fade">The archive &nbsp;·&nbsp; {count} pieces</p>
      <h1 class="lines ahero__title">
        <span class="line"><span>Old cloth,</span></span>
        <span class="line"><span>new <em>ideas.</em></span></span>
      </h1>
      <p class="lede ahero__lede" data-reveal>Since 1969 two generations have gathered a private collection of Indian textiles: nakshi kantha from Bengal, double‑ikat patola from Patan, appliqué canopies and embroidered friezes from Saurashtra, phulkari from Punjab, Kashmir shawls, bandhani, mochi and mirror-work, kalamkari, zardozi on velvet and Banarasi brocade. It is a working library. Clients are welcome to design from it.</p>
    </div>
  </section>

  <section class="section afilters-wrap">
    <div class="wrap">
      <div class="afilters" data-filters data-reveal>
        <button class="afilter is-active" data-filter="all" data-hover>All</button>
        {groups.map((g) => <button class="afilter" data-filter={g.key} data-hover>{g.label} <sup>{g.items.length}</sup></button>)}
      </div>

      <div class="agrid" data-archive-grid>
        {all.map((it, i) => (
          <a
            href={fulls.get(it.slug)}
            class="aitem"
            data-cat={it.cat}
            data-lightbox-item
            data-full={fulls.get(it.slug)}
            data-caption={it.caption}
            data-cursor-text="View"
            data-reveal
            style={`transition-delay:${(i % 4) * 0.06}s`}
          >
            <Photo slug={it.slug} ratio={it.height > it.width ? '4x5' : it.height === it.width ? '1x1' : '3x2'} size="thumb" sizes="(max-width: 700px) 50vw, (max-width: 1100px) 33vw, 25vw" />
            <span class="aitem__cap">{it.caption}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap anote">
      <hr class="stitch" />
      <div class="anote__grid">
        <p class="eyebrow">A note on the archive</p>
        <p class="body">Pieces are photographed as they are: worn, folded, occasionally mended. Most date from the late nineteenth to mid twentieth century. Honeycomb has always dealt in museum-quality Indian textiles alongside its own production; ask us about any piece. The archive is open by appointment in Ahmedabad and available to clients as a design reference for new work.</p>
      </div>
      <hr class="stitch" />
    </div>
  </section>

  <Lightbox />
</Base>

<style>
  .ahero { padding: 11rem 0 clamp(4rem, 9vw, 7rem); }
  .ahero__inner { display: flex; flex-direction: column; gap: 1.6rem; }
  .ahero__title { font-size: var(--t-2xl); }
  .ahero__lede { max-width: 60ch; color: rgba(243, 237, 226, 0.8); }
  .afilters-wrap { padding-top: 2.5rem; }
  .afilters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: clamp(2rem, 5vw, 4rem); position: sticky; top: 4.6rem; z-index: 5; padding: 0.8rem 0; background: color-mix(in srgb, var(--cotton) 88%, transparent); backdrop-filter: blur(10px); }
  .afilter { font-size: var(--t-sm); letter-spacing: 0.04em; padding: 0.55em 1em; border: 1px solid var(--line); border-radius: 999px; transition: background 0.4s, color 0.4s, border-color 0.4s; }
  .afilter sup { font-size: 0.65em; opacity: 0.6; margin-left: 0.2em; }
  .afilter:hover { border-color: var(--ink); }
  .afilter.is-active { background: var(--forest); color: var(--cotton); border-color: var(--forest); }
  .agrid { columns: 4; column-gap: var(--gutter); }
  .aitem { display: block; break-inside: avoid; margin-bottom: var(--gutter); color: inherit; }
  .aitem[hidden] { display: none; }
  .aitem :global(img) { transition: transform 1.2s var(--ease-out); }
  .aitem:hover :global(img) { transform: scale(1.04); }
  .aitem__cap { display: block; margin-top: 0.6rem; font-size: var(--t-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }
  .anote__grid { display: grid; grid-template-columns: 1fr 3fr; gap: var(--gutter); padding-block: 2.5rem; }
  @media (max-width: 1100px) { .agrid { columns: 3; } }
  @media (max-width: 700px) { .agrid { columns: 2; } .anote__grid { grid-template-columns: 1fr; } .afilters { position: static; } }
</style>
