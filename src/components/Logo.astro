---
/**
 * The Honeycomb International mark: a horse-and-rider appliqué motif and a
 * hand-lettered wordmark, traced from the original 2012 print files.
 */
import logo from '../assets/brand/logo.json';
interface Props { class?: string; compact?: boolean; stacked?: boolean; markOnly?: boolean }
const { class: cls = '', compact = false, stacked = false, markOnly = false } = Astro.props;
const { mark, word } = logo as Record<string, { w: number; h: number; transform: string; d: string }>;
---
<a href="/" class:list={['logo', cls, { 'logo--compact': compact, 'logo--stacked': stacked, 'logo--mark-only': markOnly }]} aria-label="Honeycomb International, home">
  <svg class="logo__mark" viewBox={`0 0 ${mark.w} ${mark.h}`} aria-hidden="true">
    <g transform={mark.transform} fill="currentColor"><path d={mark.d} /></g>
  </svg>
  {!markOnly && (
    <svg class="logo__word" viewBox={`0 0 ${word.w} ${word.h}`} role="img" aria-label="Honeycomb International">
      <g transform={word.transform} fill="currentColor"><path d={word.d} /></g>
    </svg>
  )}
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.75rem; color: inherit; }
  .logo__mark { height: 2.4rem; width: auto; flex: none; }
  .logo__word { height: 0.78rem; width: auto; display: block; }
  .logo--compact .logo__word { display: none; }
  .logo--stacked { flex-direction: column; align-items: center; gap: 0.9rem; }
  .logo--stacked .logo__mark { height: 5rem; }
  .logo--stacked .logo__word { height: 1rem; }
  @media (max-width: 640px) { .logo__mark { height: 2rem; } .logo__word { height: 0.62rem; } }
</style>
