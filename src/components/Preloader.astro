---
import logo from '../assets/brand/logo.json';
const { mark, word } = logo as Record<string, { w: number; h: number; transform: string; d: string }>;
---
<div class="loader" data-loader aria-hidden="true">
  <div class="loader__inner">
    <svg class="loader__mark" viewBox={`0 0 ${mark.w} ${mark.h}`}>
      <defs>
        <clipPath id="loader-wipe"><rect class="loader__wipe" x="0" y="0" width={mark.w} height={mark.h} /></clipPath>
      </defs>
      <g transform={mark.transform} fill="currentColor" clip-path="url(#loader-wipe)"><path d={mark.d} /></g>
    </svg>
    <svg class="loader__word" viewBox={`0 0 ${word.w} ${word.h}`}>
      <g transform={word.transform} fill="currentColor"><path d={word.d} /></g>
    </svg>
    <span class="loader__sub">Ahmedabad · Since 1969</span>
  </div>
  <hr class="loader__thread" />
</div>

<style>
  .loader { position: fixed; inset: 0; z-index: 100; background: var(--forest); color: var(--cotton); display: grid; place-items: center; }
  .loader__inner { display: flex; flex-direction: column; align-items: center; gap: 1.4rem; }
  .loader__mark { height: clamp(5rem, 14vh, 8rem); width: auto; }
  .loader__wipe { transform: translateY(100%); animation: wipe 1.1s var(--ease-in-out) forwards; animation-delay: 0.1s; }
  .loader__word { height: clamp(0.9rem, 2.2vw, 1.3rem); width: auto; opacity: 0; transform: translateY(8px); animation: rise 0.9s var(--ease-out) forwards; animation-delay: 0.6s; }
  .loader__sub { font-size: var(--t-xs); letter-spacing: 0.3em; text-transform: uppercase; opacity: 0; animation: fade 0.8s 0.9s forwards; }
  .loader__thread { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; margin: 0; border: 0; background: var(--turmeric); transform-origin: left; transform: scaleX(0); animation: thread 1.6s var(--ease-in-out) forwards; }
  @keyframes wipe { to { transform: translateY(0); } }
  @keyframes rise { to { opacity: 1; transform: none; } }
  @keyframes fade { to { opacity: 0.7; } }
  @keyframes thread { to { transform: scaleX(1); } }
  .loader.is-done { transition: transform 0.9s var(--ease-in-out); transform: translateY(-100%); }
  .loader.is-skipped { display: none; }
</style>
